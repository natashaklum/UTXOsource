<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>utxoproof all-time summary</title>
<style>
  body { font-family: sans-serif; max-width: 900px; margin: 2em auto; padding: 0 1em; color: #222; }
  table { border-collapse: collapse; width: 100%; margin: 1em 0; }
  th, td { border: 1px solid #999; padding: 0.4em 0.6em; text-align: right; }
  th:first-child, td:first-child { text-align: left; }
  th { background: #eee; }
  .disclaimer { font-size: 0.85em; color: #555; border-top: 1px solid #999; margin-top: 2em; padding-top: 1em; }
  @media print {
    body { margin: 0; }
    tr { page-break-inside: avoid; }
  }
</style>
</head>
<body>
<h1>utxoproof all-time summary</h1>
<p>Generated {{ generated_at }} by utxoproof {{ version }} (demo data).
Realised gains per year plus remaining lot inventory (cost basis only).</p>

<h2>Per-year realised gains</h2>
<table>
  <tr><th>Year</th><th>Disposals</th><th>Gain (EUR)</th></tr>
  {% for row in years %}
  <tr><td>{{ row.year }}</td><td>{{ row.disposals }}</td><td>{{ row.gain }}</td></tr>
  {% endfor %}
  <tr><td><strong>Total</strong></td><td></td><td><strong>{{ total_gain }}</strong></td></tr>
</table>

<h2>Remaining inventory</h2>
<table>
  <tr><th>BTC</th><th>Cost basis (EUR)</th></tr>
  <tr><td>{{ inventory_btc }}</td><td>{{ inventory_cost }}</td></tr>
</table>

<p class="disclaimer">{{ disclaimer }}</p>
</body>
</html>
